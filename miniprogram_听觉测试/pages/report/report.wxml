<view class="page">
  <brand-header></brand-header>
  <view wx:if="{{!hasData}}" class="card">
    <text class="empty-text">暂无{{typeLabel}}测评数据，请先完成对应测试。</text>
    <button class="btn btn-green" hover-class="btn-pressed" bindtap="goHome">返回</button>
  </view>

  <view wx:else class="card">
    <view class="player-row">
      <text class="player-item">测评编号：{{playerName}}</text>
      <text class="player-item">日期：{{reportDate}}</text>
      <text wx:if="{{referrerTeacherId}}" class="player-item">推荐码：{{referrerTeacherId}}</text>
    </view>

    <text class="report-title">{{isComposite ? '📊 视听双通道综合专注力评估报告' : ('📊 ' + typeLabel + '测评报告')}}</text>

    <block wx:if="{{isComposite}}">
      <view class="score-box">
        <text class="score-num">{{compositeTotal}}</text>
        <text class="score-unit">综合总分</text>
      </view>
      <view class="composite-sub-row">
        <text class="composite-sub">🎧 听觉 第 {{auditoryLevel}} 级</text>
        <text class="composite-sub">👁️ 视觉 第 {{visualLevel}} 级</text>
      </view>
    </block>
    <block wx:else>
      <view class="score-box">
        <text class="score-num">{{finalLevel}}</text>
        <text class="score-unit">级 / 满 {{maxLevel}} 级</text>
      </view>
    </block>

    <view class="grade-badge {{gradeCls}}">{{gradeText}}</view>

    <view wx:if="{{auditoryProfile.length}}" class="section-block">
      <text class="section-label">听觉记忆广度分级参照</text>
      <text class="profile-lead">请对照测评级别，查看对应的听觉记忆与课堂表现特征。</text>
      <view wx:for="{{auditoryProfile}}" wx:key="index" class="profile-row {{item.isMine ? 'profile-mine' : ''}}">
        <text class="profile-title">{{item.title}}<text wx:if="{{item.isMine}}" class="profile-tag">您的水平</text></text>
        <text class="profile-line">{{item.recite}}</text>
        <text class="profile-line">{{item.classroom}}</text>
      </view>
    </view>

    <view wx:if="{{dimensionRows.length}}" class="section-block">
      <text class="section-label">六大认知维度画像</text>
      <view wx:for="{{dimensionRows}}" wx:key="index" class="dimension-row">
        <text class="dimension-label">{{item.label}}</text>
        <view class="dimension-track">
          <view class="dimension-fill" style="width:{{item.value}}%;"></view>
        </view>
        <text class="dimension-value">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{ageNormRows.length}}" class="section-block">
      <text class="section-label">同年龄段常模对比</text>
      <view wx:for="{{ageNormRows}}" wx:key="index" class="norm-row">
        <text class="norm-text">{{item}}</text>
      </view>
    </view>

    <view wx:if="{{diagnosisText}}" class="section-block">
      <text class="section-label">认知能力诊断</text>
      <text class="diagnosis-text">{{diagnosisText}}</text>
    </view>

    <block wx:if="{{!isComposite}}">
      <text class="section-label">逐级测评记录</text>
      <view class="history-list">
        <view wx:for="{{historyRows}}" wx:key="index" class="history-row">
          <text class="history-label">{{item.label}}</text>
          <view class="history-right">
            <text class="history-detail">{{item.detail}}</text>
            <text class="history-status {{item.passed ? 'pass' : 'fail'}}">{{item.passed ? '通过' : '未通过'}}</text>
          </view>
        </view>
      </view>
    </block>

    <button wx:if="{{showContinueBtn}}" class="btn btn-green" hover-class="btn-pressed" bindtap="goContinue">{{continueBtnText}}</button>
    <button class="btn {{showContinueBtn ? 'btn-ghost' : 'btn-green'}}" hover-class="btn-pressed" bindtap="goHome">返回首页</button>
  </view>

  <view wx:if="{{hasData}}" class="card contact-card">
    <text class="contact-title">🎁 凭报告截图免费领取</text>
    <text class="contact-sub">截图保存本次测评报告，长按识别二维码添加专注力专家老师，凭截图免费领取针对短板维度定制的《7天家庭视觉/听觉提升训练计划表》，并可预约专家1对1免费语音诊断15分钟</text>
    <image class="contact-qrcode" src="/assets/team/teacher_qrcode.jpg" mode="widthFix" show-menu-by-longpress="{{true}}"></image>
  </view>
</view>
