@import "../../styles/duo-btn.wxss";

.page {
  min-height: 100vh;
  background: #f7f5ef;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(16,19,26,0.06);
}
.empty-text {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #5b6472;
  margin-bottom: 24rpx;
}
.player-row {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-bottom: 20rpx;
}
.player-item { font-size: 22rpx; color: #9aa1b0; }

.report-title {
  display: block;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #10131a;
  margin-bottom: 28rpx;
}
.composite-sub-row {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 20rpx;
}
.composite-sub { font-size: 26rpx; font-weight: 700; color: #5b6472; }
.score-box {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.score-num {
  font-size: 96rpx;
  font-weight: 900;
  color: #b08d57;
}
.score-unit { font-size: 26rpx; color: #5b6472; }

.grade-badge {
  display: block;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  padding: 14rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.grade-superior { background: rgba(28,176,246,0.12); color: #1cb0f6; }
.grade-excellent { background: rgba(88,204,2,0.12); color: #4ade80; }
.grade-good { background: rgba(250,204,21,0.15); color: #b45309; }
.grade-developing { background: rgba(251,146,60,0.14); color: #c2410c; }

.profile-lead { display: block; font-size: 22rpx; color: #5b6472; margin-bottom: 14rpx; }
.profile-row {
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background: #f7f5ef;
}
.profile-mine { border-color: #1cb0f6; background: #ddf4ff; }
.profile-title { display: block; font-size: 24rpx; font-weight: 800; color: #10131a; margin-bottom: 6rpx; }
.profile-tag {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 99px;
  background: #1cb0f6;
  color: #fff;
  font-size: 20rpx;
}
.profile-line { display: block; font-size: 22rpx; line-height: 1.7; color: #475569; }

.section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: #10131a;
  margin-bottom: 14rpx;
}
.section-block { margin-bottom: 28rpx; }

.dimension-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.dimension-label { flex: 0 0 160rpx; font-size: 20rpx; color: #5b6472; font-weight: 700; }
.dimension-track { flex: 1; height: 14rpx; background: #f1f0eb; border-radius: 99px; overflow: hidden; }
.dimension-fill { height: 100%; background: linear-gradient(90deg, #1cb0f6, #58cc02); border-radius: 99px; }
.dimension-value { flex: 0 0 48rpx; font-size: 20rpx; font-weight: 800; color: #10131a; text-align: right; }

.norm-row { margin-bottom: 8rpx; }
.norm-text { font-size: 22rpx; color: #475569; line-height: 1.6; }

.diagnosis-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.75;
  color: #475569;
  background: #f7f5ef;
  padding: 20rpx;
  border-radius: 16rpx;
}

.history-list { margin-bottom: 28rpx; }
.history-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1px solid #e6e1d6;
}
.history-row:last-child { border-bottom: none; }
.history-label { font-size: 24rpx; color: #10131a; font-weight: 700; }
.history-right { display: flex; align-items: center; gap: 12rpx; }
.history-detail { font-size: 22rpx; color: #9aa1b0; }
.history-status { font-size: 22rpx; font-weight: 800; }
.history-status.pass { color: #58cc02; }
.history-status.fail { color: #ff4b4b; }

.contact-card { margin-top: 24rpx; text-align: center; }
.contact-title { display: block; font-size: 28rpx; font-weight: 800; color: #10131a; margin-bottom: 10rpx; }
.contact-sub { display: block; font-size: 22rpx; color: #5b6472; margin-bottom: 20rpx; }
.contact-qrcode { width: 280rpx; height: 280rpx; border-radius: 16rpx; }

