<view class="page">
  <view class="header">
    <text class="level-title">{{levelTitle}}</text>
    <text class="level-tag">{{levelTag}}</text>
  </view>
  <text class="attempt-desc">{{attemptDesc}}</text>

  <!-- 查看阶段 -->
  <view wx:if="{{stage === 'view'}}" class="card">
    <text class="stage-label">👁️ 请记住色块的位置 · 剩余 {{timeLeft}}s</text>
    <view class="corsi-grid">
      <view wx:for="{{gridCells}}" wx:key="index" class="cell {{item}}"></view>
    </view>
  </view>

  <!-- 干扰数学题阶段 -->
  <view wx:if="{{stage === 'math'}}" class="card">
    <text class="stage-label">🧮 请先算对下面的算式（剩余 {{mathTimeLeft}}s）</text>
    <text class="math-exp">{{mathExp}}</text>
    <input
      class="pinyin-input"
      type="number"
      value="{{mathInput}}"
      placeholder="请输入答案"
      bindinput="onMathInput"
      confirm-type="done"
      bindconfirm="checkMathAnswer"
    />
    <text class="math-feedback">{{mathFeedback}}</text>
    <button class="btn btn-green" bindtap="checkMathAnswer">确认答案</button>
  </view>

  <!-- 回忆复原阶段 -->
  <view wx:if="{{stage === 'recall'}}" class="card">
    <text class="stage-label">🎯 点击还原色块位置 · 已选 {{selectedCount}} / 目标 {{targetCount}} 格</text>
    <view class="corsi-grid">
      <view
        wx:for="{{gridCells}}"
        wx:key="index"
        class="cell {{item}}"
        data-index="{{index}}"
        bindtap="onCellTap"
      ></view>
    </view>
    <button class="btn btn-green" bindtap="submitRecall">提交答案</button>
  </view>

  <!-- 结果阶段 -->
  <view wx:if="{{stage === 'result'}}" class="card">
    <view class="banner {{bannerClass}}">
      <text class="banner-title">{{bannerTitle}}</text>
      <text class="banner-sub">{{bannerSub}}</text>
    </view>

    <view class="result-grids">
      <view class="result-grid-col">
        <text class="chip-row-label">你的作答</text>
        <view class="corsi-grid corsi-grid-small">
          <view wx:for="{{resultUserGrid}}" wx:key="index" class="cell {{item}}"></view>
        </view>
      </view>
      <view class="result-grid-col">
        <text class="chip-row-label">标准答案</text>
        <view class="corsi-grid corsi-grid-small">
          <view wx:for="{{resultAnswerGrid}}" wx:key="index" class="cell {{item}}"></view>
        </view>
      </view>
    </view>

    <button class="btn btn-green" bindtap="onBannerAction">{{bannerBtnText}}</button>
  </view>

  <!-- 完成阶段 -->
  <view wx:if="{{stage === 'done'}}" class="card">
    <text class="done-title">🏆 视觉专注力测试完成</text>
    <text class="done-sub">最终等级：第 {{finalLevel}} 级</text>
    <text class="done-sub">已通过级别：{{passedLevelsText}}</text>
    <button class="btn btn-green" bindtap="goReport">📊 查看视觉测评报告</button>
    <button class="btn btn-green" bindtap="goAuditory">🎧 继续挑战听觉专注力测试</button>
    <button class="btn btn-ghost" bindtap="restart">重新开始</button>
  </view>
</view>
