.page {
  min-height: 100vh;
  background: #f7f5ef;
  padding: 24rpx;
  box-sizing: border-box;
}
.header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 8rpx 0 16rpx;
}
.level-title { font-size: 34rpx; font-weight: 800; color: #10131a; }
.level-tag {
  font-size: 22rpx;
  color: #b08d57;
  background: rgba(176,141,87,0.12);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.attempt-desc { display: block; font-size: 24rpx; color: #5b6472; margin-bottom: 28rpx; }

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(16,19,26,0.06);
}

.stage-label {
  display: block;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #10131a;
  margin-bottom: 20rpx;
}

.corsi-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 4rpx;
  margin-bottom: 24rpx;
}
.corsi-grid-small { margin-bottom: 0; }
.cell {
  width: 100%;
  aspect-ratio: 1;
  background: #e6e1d6;
  border-radius: 4rpx;
}
.cell.blue { background: #1cb0f6; }
.cell.green { background: #58cc02; }

.math-exp {
  display: block;
  text-align: center;
  font-size: 48rpx;
  font-weight: 800;
  color: #10131a;
  margin-bottom: 20rpx;
}
.pinyin-input {
  border: 2rpx solid #e6e1d6;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  margin-bottom: 12rpx;
  text-align: center;
}
.math-feedback {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #ff4b4b;
  margin-bottom: 16rpx;
  min-height: 32rpx;
}

.btn {
  width: 100%;
  border-radius: 16rpx;
  font-weight: 800;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.btn-green { background: #58cc02; color: #fff; }
.btn-ghost { background: #f1f0eb; color: #5b6472; }

.banner { border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.banner.pass { background: rgba(88,204,2,0.1); }
.banner.fail { background: rgba(255,75,75,0.1); }
.banner-title { display: block; font-size: 30rpx; font-weight: 800; margin-bottom: 8rpx; }
.banner-sub { display: block; font-size: 24rpx; color: #5b6472; }

.result-grids {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.result-grid-col { flex: 1; }
.chip-row-label {
  display: block;
  font-size: 22rpx;
  color: #9aa1b0;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.done-title { display: block; font-size: 34rpx; font-weight: 800; text-align: center; margin-bottom: 16rpx; }
.done-sub { display: block; font-size: 26rpx; color: #5b6472; text-align: center; margin-bottom: 8rpx; }
