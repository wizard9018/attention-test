<view class="page">
  <brand-header></brand-header>
  <view class="header">
    <text class="level-title">{{levelTitle}}</text>
    <text class="level-tag">{{levelTag}}</text>
  </view>
  <text class="attempt-desc">{{attemptDesc}}</text>

  <!-- 播放阶段 -->
  <view wx:if="{{stage === 'playing'}}" class="card">
    <view class="cue-track">
      <view
        wx:for="{{cueDots}}"
        wx:key="index"
        class="cue-dot {{item}}"
      ></view>
    </view>
    <text class="playing-text">{{playingText}}</text>
  </view>

  <!-- 输入阶段 -->
  <view wx:if="{{stage === 'input'}}" class="card">
    <text class="input-hint">已听完 {{sequenceLen}} 个字，请输入拼音（每个字用空格隔开，如：ni hao）</text>

    <view class="record-aid-card">
      <text class="record-aid-text">🎙️ 可先录下您记住的复述声音，遗忘拼音时随时回放辅助回忆</text>
      <view class="record-aid-btns">
        <button class="btn-record {{isRecording ? 'recording' : ''}}" hover-class="btn-pressed" bindtap="toggleMyRecording">{{isRecording ? '⏹ 停止录音' : '🎙️ 录制复述'}}</button>
        <button wx:if="{{hasMyRecording}}" class="btn-play" hover-class="btn-pressed" bindtap="playMyRecording">▶ 回放录音</button>
      </view>
    </view>

    <input
      class="pinyin-input"
      value="{{inputValue}}"
      placeholder="请输入拼音，空格分隔"
      bindinput="onInputChange"
      confirm-type="done"
      bindconfirm="submitAnswer"
    />

    <view class="preview-card">
      <view class="preview-head">
        <text class="preview-label">实时拼音解析预览</text>
        <text class="preview-count">已输入: {{filledCount}} 字 / 目标: {{sequenceLen}} 字</text>
      </view>
      <view class="preview-chips">
        <view wx:for="{{previewChips}}" wx:key="index" class="preview-chip {{item.filled ? 'filled' : ''}}">
          <text class="preview-chip-idx">第{{item.idx}}字</text>
          <text class="preview-chip-py">{{item.py}}</text>
        </view>
      </view>
    </view>

    <button class="btn btn-green" hover-class="btn-pressed" bindtap="submitAnswer">提交答案</button>
    <button class="btn btn-ghost" hover-class="btn-pressed" bindtap="replayCurrent">🔁 重听本轮</button>
  </view>

  <!-- 结果阶段 -->
  <view wx:if="{{stage === 'result'}}" class="card">
    <view class="banner {{bannerClass}}">
      <text class="banner-title">{{bannerTitle}}</text>
      <text class="banner-sub">{{bannerSub}}</text>
    </view>

    <view class="chip-row-label">标准读音</view>
    <view class="chip-row">
      <view wx:for="{{targetChips}}" wx:key="index" class="chip">
        <text class="chip-main">{{item.py}}</text>
        <text class="chip-sub">{{item.tone}}声</text>
      </view>
    </view>

    <view class="chip-row-label">你的作答</view>
    <view class="chip-row">
      <view wx:for="{{actualChips}}" wx:key="index" class="chip chip-{{item.status}}">
        <text class="chip-main">{{item.py}}</text>
        <text class="chip-sub">{{item.tone}}</text>
      </view>
    </view>

    <button class="btn btn-green" hover-class="btn-pressed" bindtap="onBannerAction">{{bannerBtnText}}</button>
  </view>

</view>
