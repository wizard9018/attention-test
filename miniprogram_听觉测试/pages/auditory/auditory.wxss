.page {
  min-height: 100vh;
  background: #f7f5ef;
  padding: 24rpx;
  box-sizing: border-box;
}
.header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 8rpx 0 16rpx;
}
.level-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #10131a;
}
.level-tag {
  font-size: 22rpx;
  color: #b08d57;
  background: rgba(176,141,87,0.12);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.attempt-desc {
  display: block;
  font-size: 24rpx;
  color: #5b6472;
  margin-bottom: 28rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(16,19,26,0.06);
}

.cue-track {
  display: flex;
  gap: 12rpx;
  justify-content: center;
  margin-bottom: 32rpx;
  flex-wrap: wrap;
}
.cue-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #e6e1d6;
}
.cue-dot.playing { background: #1cb0f6; transform: scale(1.3); }
.cue-dot.done { background: #58cc02; }
.playing-text {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #10131a;
  font-weight: 700;
}

.input-hint {
  display: block;
  font-size: 24rpx;
  color: #5b6472;
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.pinyin-input {
  border: 2rpx solid #e6e1d6;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.record-aid-card {
  background: #fef2f2;
  border: 2rpx dashed #fecaca;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.record-aid-text { display: block; font-size: 22rpx; font-weight: 800; color: #991b1b; margin-bottom: 14rpx; line-height: 1.6; }
.record-aid-btns { display: flex; gap: 12rpx; flex-wrap: wrap; }
.btn-record { background: #ff4b4b; color: #fff; font-size: 24rpx; padding: 0 24rpx; margin: 0; }
.btn-record.recording { background: #b91c1c; }
.btn-play { background: #1cb0f6; color: #fff; font-size: 24rpx; padding: 0 24rpx; margin: 0; }

.preview-card {
  background: #f8fafc;
  border: 2rpx dashed #e6e1d6;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.preview-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; flex-wrap: wrap; gap: 8rpx; }
.preview-label { font-size: 22rpx; font-weight: 800; color: #9aa1b0; }
.preview-count { font-size: 22rpx; font-weight: 900; color: #1899d6; }
.preview-chips { display: flex; justify-content: center; gap: 12rpx; flex-wrap: wrap; }
.preview-chip {
  background: #fff;
  border: 2rpx solid #e6e1d6;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  text-align: center;
  min-width: 96rpx;
}
.preview-chip.filled { background: #ddf4ff; border-color: #1cb0f6; }
.preview-chip-idx { display: block; font-size: 18rpx; font-weight: 800; color: #9aa1b0; }
.preview-chip.filled .preview-chip-idx { color: #1899d6; }
.preview-chip-py { display: block; font-size: 28rpx; font-weight: 900; color: #10131a; margin-top: 4rpx; }

.btn {
  width: 100%;
  border-radius: 16rpx;
  font-weight: 800;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.btn-green { background: #58cc02; color: #fff; }
.btn-ghost { background: #f1f0eb; color: #5b6472; }

.banner {
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.banner.pass { background: rgba(88,204,2,0.1); }
.banner.fail { background: rgba(255,75,75,0.1); }
.banner-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}
.banner-sub {
  display: block;
  font-size: 24rpx;
  color: #5b6472;
}

.chip-row-label {
  font-size: 22rpx;
  color: #9aa1b0;
  font-weight: 700;
  margin: 16rpx 0 10rpx;
}
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.chip {
  background: #f7f5ef;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  text-align: center;
  min-width: 100rpx;
}
.chip-main { display: block; font-size: 26rpx; font-weight: 800; color: #10131a; }
.chip-sub { display: block; font-size: 18rpx; color: #9aa1b0; }
.chip-hit { background: rgba(88,204,2,0.15); }
.chip-fuzzy { background: rgba(255,193,7,0.18); }
.chip-wrong, .chip-miss { background: rgba(255,75,75,0.15); }

.done-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 16rpx;
}
.done-sub {
  display: block;
  font-size: 26rpx;
  color: #5b6472;
  text-align: center;
  margin-bottom: 8rpx;
}
