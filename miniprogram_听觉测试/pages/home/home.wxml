<view class="page">
  <brand-header></brand-header>

  <view class="card intro-card">
    <text class="eyebrow">🎓 K12 认知与专注力发展测评</text>
    <text class="title">读懂孩子的<text class="accent">专注力</text>，从一次科学测评开始</text>
    <text class="subtitle">10~15 分钟量化孩子的听觉序列记忆广度与视觉空间工作记忆容量，测后即时生成专业发展报告</text>
    <view class="theory-box">
      <text class="theory-title">📚 理论依据：米勒 7±2 法则</text>
      <text class="theory-text">1956 年，美国心理学家乔治·米勒发表里程碑论文《神奇数字7±2》，提出人的短时记忆容量约为 5～9 个组块，奠定了本测评听觉记忆广度维度的理论基础。</text>
    </view>
  </view>

  <view class="card">
    <text class="title">👋 填写信息，开始测试</text>

    <view class="field">
      <text class="label">学生姓名</text>
      <input class="input" value="{{name}}" placeholder="请输入姓名" maxlength="10" data-field="name" bindinput="onFieldInput" />
    </view>
    <view class="field">
      <text class="label">所在学校</text>
      <input class="input" value="{{school}}" placeholder="请输入学校" maxlength="16" data-field="school" bindinput="onFieldInput" />
    </view>
    <view class="field">
      <text class="label">手机号/微信号</text>
      <input class="input" value="{{phone}}" placeholder="请输入手机号或微信号" maxlength="20" data-field="phone" bindinput="onFieldInput" />
    </view>
    <view class="field">
      <text class="label">年龄</text>
      <input class="input" type="number" value="{{age}}" placeholder="请输入年龄" data-field="age" bindinput="onFieldInput" />
    </view>
    <view class="field">
      <text class="label">推荐码（选填）</text>
      <input class="input" type="number" value="{{referrerTeacherId}}" placeholder="如有推荐码，请输入5位推荐码" maxlength="5" data-field="referrerTeacherId" bindinput="onFieldInput" />
    </view>

    <text wx:if="{{errorText}}" class="error-text">⚠️ {{errorText}}</text>

    <button class="btn btn-green" bindtap="startDual">🚀 开始双通道综合专注力测评</button>
    <text class="privacy-note">🔒 信息仅用于生成本次测评报告</text>
  </view>

  <view class="card phase-card phase-auditory" bindtap="startAuditory">
    <text class="phase-title">🎧 第一阶段：听觉专注力</text>
    <text class="phase-desc">认真倾听计算机朗读的无关联汉字（5~12字）。朗读结束后，直接输入拼音（字间加空格），系统自动智能纠音评分。</text>
    <button class="btn btn-solo-green" catchtap="startAuditory">仅单独测试听觉专注力 →</button>
  </view>

  <view class="card phase-card phase-visual" bindtap="startVisual">
    <text class="phase-title">👁️ 第二阶段：视觉专注力</text>
    <text class="phase-desc">观察 10×10 网格中的色块图形并记忆。随后快速口算一道简单算术题（抗干扰），最后在空白网格中点击复原图形。</text>
    <button class="btn btn-solo-yellow" catchtap="startVisual">仅单独测试视觉专注力 →</button>
  </view>
</view>
