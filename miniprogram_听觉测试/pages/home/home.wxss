.page {
  min-height: 100vh;
  background: #f7f5ef;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(16,19,26,0.06);
  margin-bottom: 24rpx;
}
.card:last-child { margin-bottom: 0; }

.intro-card { text-align: center; }
.eyebrow {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 800;
  color: #1cb0f6;
  background: rgba(28,176,246,0.12);
  padding: 6rpx 20rpx;
  border-radius: 99px;
  margin-bottom: 16rpx;
}
.intro-card .title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #10131a;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.accent { color: #1cb0f6; }
.intro-card .subtitle {
  display: block;
  font-size: 24rpx;
  color: #5b6472;
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.theory-box {
  background: #ddf4ff;
  border: 2rpx solid #1cb0f6;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: left;
}
.theory-title { display: block; font-size: 24rpx; font-weight: 800; color: #1899d6; margin-bottom: 10rpx; }
.theory-text { display: block; font-size: 22rpx; line-height: 1.7; color: #475569; }

.phase-card { }
.phase-title { display: block; font-size: 30rpx; font-weight: 800; margin-bottom: 12rpx; }
.phase-auditory .phase-title { color: #15803d; }
.phase-visual .phase-title { color: #854d0e; }
.phase-desc { display: block; font-size: 24rpx; color: #5b6472; line-height: 1.7; margin-bottom: 20rpx; }
.btn-solo-green { background: #dcfce7; color: #15803d; font-size: 26rpx; margin-bottom: 0; }
.btn-solo-yellow { background: #fef9c3; color: #854d0e; font-size: 26rpx; margin-bottom: 0; }
.title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #10131a;
  margin-bottom: 12rpx;
}
.btn {
  border-radius: 16rpx;
  font-weight: 800;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.btn-green { background: #58cc02; color: #fff; }
.privacy-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #9aa1b0;
}
