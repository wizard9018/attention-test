.page {
  min-height: 100vh;
  background: #f7f5ef;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(16,19,26,0.06);
}
.title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #10131a;
  margin-bottom: 12rpx;
}
.subtitle {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #5b6472;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.field { margin-bottom: 24rpx; }
.label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #5b6472;
  margin-bottom: 10rpx;
}
.input {
  border: 2rpx solid #e6e1d6;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background: #f7f5ef;
}
.error-text {
  display: block;
  font-size: 24rpx;
  color: #ff4b4b;
  margin-bottom: 16rpx;
}
.btn {
  border-radius: 16rpx;
  font-weight: 800;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.btn-green { background: #58cc02; color: #fff; }
.solo-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.btn-solo {
  flex: 1;
  background: #f1f0eb;
  color: #10131a;
  font-size: 26rpx;
  margin-bottom: 0;
}
.privacy-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #9aa1b0;
}
