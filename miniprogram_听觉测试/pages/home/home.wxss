.page {
  min-height: 100vh;
  background: #f7f5ef;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(16,19,26,0.06);
  margin-bottom: 24rpx;
}
.card:last-child { margin-bottom: 0; }

.section-eyebrow {
  display: block;
  font-size: 22rpx;
  font-weight: 900;
  color: #58cc02;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}
.brand-card { background: linear-gradient(135deg, #1e293b, #0f172a); }
.brand-card .section-eyebrow { color: #86efac; }
.brand-slogan { display: block; font-size: 34rpx; font-weight: 900; color: #fff; margin-bottom: 12rpx; }
.brand-line { display: block; font-size: 24rpx; font-weight: 700; color: #f1f5f9; line-height: 1.6; }
.brand-line.accent { color: #4ade80; margin-top: 6rpx; }
.brand-story { display: block; font-size: 22rpx; color: #cbd5e1; line-height: 1.7; margin-top: 20rpx; }

.founder-row { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.founder-item { flex: 1; text-align: center; }
.founder-photo { width: 100rpx; height: 100rpx; border-radius: 50%; margin-bottom: 12rpx; border: 3rpx solid #d7ffb8; }
.founder-name { display: block; font-size: 26rpx; font-weight: 900; color: #10131a; margin-bottom: 8rpx; }
.founder-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  background: #58cc02;
  padding: 3rpx 12rpx;
  border-radius: 99px;
  margin-left: 6rpx;
}
.founder-bio { display: block; font-size: 20rpx; color: #5b6472; line-height: 1.6; }

.mentor-label { display: block; font-size: 24rpx; font-weight: 800; color: #10131a; margin-bottom: 14rpx; }
.mentor-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1px dashed #e6e1d6;
}
.mentor-row:last-child { border-bottom: none; }
.mentor-name { font-size: 24rpx; font-weight: 800; color: #10131a; }
.mentor-school { font-size: 22rpx; color: #9aa1b0; }

.scroll-hint {
  text-align: center;
  font-size: 22rpx;
  color: #9aa1b0;
  margin-bottom: 24rpx;
}

.intro-card { text-align: center; }
.eyebrow {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 800;
  color: #1cb0f6;
  background: rgba(28,176,246,0.12);
  padding: 6rpx 20rpx;
  border-radius: 99px;
  margin-bottom: 16rpx;
}
.intro-card .title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #10131a;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.accent { color: #1cb0f6; }
.intro-card .subtitle {
  display: block;
  font-size: 24rpx;
  color: #5b6472;
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.badge-row { display: flex; justify-content: center; gap: 12rpx; flex-wrap: wrap; margin-bottom: 24rpx; }
.badge {
  font-size: 20rpx;
  font-weight: 800;
  color: #1899d6;
  background: #ddf4ff;
  padding: 8rpx 18rpx;
  border-radius: 99px;
}
.theory-box {
  background: #ddf4ff;
  border: 2rpx solid #1cb0f6;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: left;
}
.theory-title { display: block; font-size: 24rpx; font-weight: 800; color: #1899d6; margin-bottom: 10rpx; }
.theory-text { display: block; font-size: 22rpx; line-height: 1.7; color: #475569; }

.phase-card { }
.phase-title { display: block; font-size: 30rpx; font-weight: 800; margin-bottom: 12rpx; }
.phase-auditory .phase-title { color: #15803d; }
.phase-visual .phase-title { color: #854d0e; }
.phase-desc { display: block; font-size: 24rpx; color: #5b6472; line-height: 1.7; margin-bottom: 20rpx; }
.btn-solo-green { background: #dcfce7; color: #15803d; font-size: 26rpx; margin-bottom: 0; }
.btn-solo-yellow { background: #fef9c3; color: #854d0e; font-size: 26rpx; margin-bottom: 0; }
.title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #10131a;
  margin-bottom: 12rpx;
}
.field { margin-bottom: 24rpx; }
.label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #5b6472;
  margin-bottom: 10rpx;
}
.input {
  border: 2rpx solid #e6e1d6;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background: #f7f5ef;
}
.error-text {
  display: block;
  font-size: 24rpx;
  color: #ff4b4b;
  margin-bottom: 16rpx;
}
.btn {
  border-radius: 16rpx;
  font-weight: 800;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.btn-green { background: #58cc02; color: #fff; }
.privacy-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #9aa1b0;
}
